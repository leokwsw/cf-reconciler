{
  "name": "cf-reconciler",
  "version": "0.1.0",
  "description": "Declarative Cloudflare DNS and Nginx reconciler",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "tsx src/cli.ts run",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "tsx": "^4.23.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
